# 0 "arch/riscv/boot/dts/starfive/vf2-overlay/vf2-overlay-uart3-i2c.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/riscv/boot/dts/starfive/vf2-overlay/vf2-overlay-uart3-i2c.dts"
/dts-v1/;
/plugin/;
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 4 "arch/riscv/boot/dts/starfive/vf2-overlay/vf2-overlay-uart3-i2c.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/starfive,jh7110-pinfunc.h" 1
# 5 "arch/riscv/boot/dts/starfive/vf2-overlay/vf2-overlay-uart3-i2c.dts" 2
/ {
 compatible = "starfive,visionfive-v2", "starfive,jh7110";


 fragment@0 {
  target-path = "/soc/gpio@13040000";
  __overlay__ {
   dt_uart3_pins: dt-uart3-pins {
    uart3-pins-tx {
     starfive,pins = <60>;
     starfive,pinmux = <(0x2acU) 0x15U 0xE00000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | ((3 << 0x1U) & 0x6U)) & 0xFF)>;
     starfive,pin-gpio-dout = <85>;
     starfive,pin-gpio-doen = <0>;
    };

    uart3-pins-rx {
     starfive,pins = <63>;
     starfive,pinmux = <(0x2acU) 0x1EU 0xC0000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | ((1 << 0x3U) & 0x8U)) & 0xFF)>;
     starfive,pin-gpio-doen = <1>;
     starfive,pin-gpio-din = <68>;
    };
   };

   dt_i2c1_pins: dt-i2c1-pins {
    i2c1-pins-scl {
     starfive,pins = <42>;
     starfive,pinmux = <(0x2a8U) 0x3U 0x38U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <0>;
     starfive,pin-gpio-doen = <17>;
     starfive,pin-gpio-din = <39>;
    };

    i2c1-pins-sda {
     starfive,pins = <43>;
     starfive,pinmux = <(0x2a8U) 0x6U 0x1C0U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <0>;
     starfive,pin-gpio-doen = <18>;
     starfive,pin-gpio-din = <40>;
    };
   };
  };
 };


 fragment@1 {
  target-path = "/soc/serial@12000000";
  __overlay__ {
   pinctrl-names = "default";
        pinctrl-0 = <&dt_uart3_pins>;
   status = "okay";
  };
 };


   fragment@2 {
  target-path = "/soc/i2c@10040000";
  __overlay__ {
   clock-frequency = <100000>;
   i2c-sda-hold-time-ns = <300>;
   i2c-sda-falling-time-ns = <510>;
   i2c-scl-falling-time-ns = <510>;
   auto_calc_scl_lhcnt;
   pinctrl-names = "default";
   pinctrl-0 = <&dt_i2c1_pins>;
   status = "okay";
  };
 };
};
