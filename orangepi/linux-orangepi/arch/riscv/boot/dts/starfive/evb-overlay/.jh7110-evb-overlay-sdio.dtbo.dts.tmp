# 0 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-sdio.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-sdio.dts"
/dts-v1/;
/plugin/;
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 4 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-sdio.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/starfive,jh7110-pinfunc.h" 1
# 5 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-sdio.dts" 2
/ {
 compatible = "starfive,jh7110";


 fragment@0 {
  target-path = "/soc/gpio@13040000";
  __overlay__ {
   dt_sdcard1_pins: dt-sdcard1-pins {
    sdcard1-pins0 {
     starfive,pins = <56>;
     starfive,pinmux = <(0x2acU) 0x9U 0xE00U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <55>;
     starfive,pin-gpio-doen = <0>;
    };

    sdcard1-pins1 {
     starfive,pins = <50>;
     starfive,pinmux = <(0x2a8U) 0x1BU 0x38000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <57>;
     starfive,pin-gpio-doen = <19>;
     starfive,pin-gpio-din = <44>;
    };

    sdcard1-pins2 {
     starfive,pins = <49>;
     starfive,pinmux = <(0x2a8U) 0x18U 0x7000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <58>;
     starfive,pin-gpio-doen = <20>;
     starfive,pin-gpio-din = <45>;
    };

    sdcard1-pins3 {
     starfive,pins = <45>;
     starfive,pinmux = <(0x2a8U) 0xCU 0x7000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <59>;
     starfive,pin-gpio-doen = <21>;
     starfive,pin-gpio-din = <46>;
    };

    sdcard1-pins4 {
     starfive,pins = <62>;
     starfive,pinmux = <(0x2acU) 0x1BU 0x38000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <60>;
     starfive,pin-gpio-doen = <22>;
     starfive,pin-gpio-din = <47>;
    };

    sdcard1-pins5 {
     starfive,pins = <40>;
     starfive,pinmux = <(0x2a4U) 0x1DU 0xE0000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <61>;
     starfive,pin-gpio-doen = <23>;
     starfive,pin-gpio-din = <48>;
    };
   };
  };
 };


 fragment@1 {
  target-path = "/soc/serial@12000000";
  __overlay__ {
   status = "okay";
  };
 };


   fragment@2 {
  target-path = "/soc/i2c@10030000";
  __overlay__ {
   status = "okay";
  };
 };


 fragment@3 {
  target-path = "/soc/sdio1@16020000";
  __overlay__ {
   max-frequency = <100000000>;
   card-detect-delay = <300>;
   bus-width = <4>;
   no-sdio;
   no-mmc;
   broken-cd;
   sd-uhs-sdr12;
   sd-uhs-sdr25;
   sd-uhs-sdr50;
   sd-uhs-sdr104;
   sd-uhs-ddr50;
   cap-sd-highspeed;
   post-power-on-delay-ms = <200>;
   pinctrl-names = "default";
   pinctrl-0 = <&dt_sdcard1_pins>;
   status = "okay";
  };
 };
};
