# 5 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-spi.dts" 2
/ {
 compatible = "starfive,jh7110";


   fragment@0 {
  target-path = "/soc/spi@10060000";
  __overlay__ {
