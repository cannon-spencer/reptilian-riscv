# 0 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart4-emmc.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart4-emmc.dts"
/dts-v1/;
/plugin/;
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 4 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart4-emmc.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/starfive,jh7110-pinfunc.h" 1
# 5 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart4-emmc.dts" 2
/ {
 compatible = "starfive,jh7110";


 fragment@0 {
  target-path = "/soc/gpio@13040000";
  __overlay__ {
   dt_emmc0_pins: dt-emmc0-pins {
    emmc0-pins-rest {
     starfive,pins = <22>;
     starfive,pinmux = <(0x2a0U) 0x6U 0x1C0U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
     starfive,pin-gpio-dout = <19>;
     starfive,pin-gpio-doen = <0>;
    };

    emmc0-pins-cLK {
     starfive,pins = <64>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-cmd {
     starfive,pins = <65>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data0 {
     starfive,pins = <66>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data1 {
     starfive,pins = <67>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data2 {
     starfive,pins = <68>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data3 {
     starfive,pins = <69>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data4 {
     starfive,pins = <70>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data5 {
     starfive,pins = <71>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data6 {
     starfive,pins = <72>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };

    emmc0-pins-data7 {
     starfive,pins = <73>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((3 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
    };
   };

   dt_emmc1_pins: dt-emmc1-pins {
    emmc1-pins0-rest {
     starfive,pins = <51>;
     starfive,pinmux = <(0x2a8U) 0x1EU 0xC0000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <66>;
     starfive,pin-gpio-doen = <0>;
    };

    emmc1-pins1 {
     starfive,pins = <38>;
     starfive,pinmux = <(0x2a4U) 0x17U 0x3800000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <55>;
     starfive,pin-gpio-doen = <0>;
    };


    emmc1-pins2 {
     starfive,pins = <36>;
     starfive,pinmux = <(0x2a4U) 0x11U 0xE0000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <57>;
     starfive,pin-gpio-doen = <19>;
     starfive,pin-gpio-din = <44>;
    };

    emmc1-pins3 {
     starfive,pins = <43>;
     starfive,pinmux = <(0x2a8U) 0x6U 0x1C0U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <58>;
     starfive,pin-gpio-doen = <20>;
     starfive,pin-gpio-din = <45>;
    };

    emmc1-pins4 {
     starfive,pins = <48>;
     starfive,pinmux = <(0x2a8U) 0x15U 0xE00000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <59>;
     starfive,pin-gpio-doen = <21>;
     starfive,pin-gpio-din = <46>;
    };

    emmc1-pins5 {
     starfive,pins = <53>;
     starfive,pinmux = <(0x2acU) 0x2U 0xCU 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <60>;
     starfive,pin-gpio-doen = <22>;
     starfive,pin-gpio-din = <47>;
    };

    emmc1-pins6 {
     starfive,pins = <63>;
     starfive,pinmux = <(0x2acU) 0x1EU 0xC0000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <61>;
     starfive,pin-gpio-doen = <23>;
     starfive,pin-gpio-din = <48>;
    };

    emmc1-pins7 {
     starfive,pins = <52>;
     starfive,pinmux = <(0x2acU) 0x0U 0x3U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <62>;
     starfive,pin-gpio-doen = <24>;
     starfive,pin-gpio-din = <49>;
    };

    emmc1-pins8 {
     starfive,pins = <39>;
     starfive,pinmux = <(0x2a4U) 0x1AU 0x1C000000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <63>;
     starfive,pin-gpio-doen = <25>;
     starfive,pin-gpio-din = <50>;
    };

    emmc1-pins9 {
     starfive,pins = <46>;
     starfive,pinmux = <(0x2a8U) 0xFU 0x38000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <64>;
     starfive,pin-gpio-doen = <26>;
     starfive,pin-gpio-din = <51>;
    };

    emmc1-pins10 {
     starfive,pins = <47>;
     starfive,pinmux = <(0x2a8U) 0x12U 0x1C0000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
     starfive,pin-gpio-dout = <65>;
     starfive,pin-gpio-doen = <27>;
     starfive,pin-gpio-din = <52>;
    };
   };
  };
 };


   fragment@1 {
  target-path = "/soc/gpio@17020000";
  __overlay__ {
   dt_pwm_ch6to7_pins: dt-pwm-ch6to7-pins {
    pwm-ch6-pins {
     starfive,pins = <1>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <5>;
     starfive,pin-gpio-doen = <4>;
    };

    pwm-ch7-pins {
     starfive,pins = <2>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <6>;
     starfive,pin-gpio-doen = <5>;
    };
   };
  };
 };


 fragment@2 {
  target-path = "/soc/serial@12010000";
  __overlay__ {
   status = "okay";
  };
 };


 fragment@3 {
  target-path = "/soc/sdio1@16020000";
  __overlay__ {
   clock-frequency = <102400000>;
   max-frequency = <100000000>;
   card-detect-delay = <300>;
   bus-width = <8>;
   cap-mmc-hw-reset;
   non-removable;
   cap-mmc-highspeed;
   post-power-on-delay-ms = <200>;
   pinctrl-names = "default";
   pinctrl-0 = <&dt_emmc1_pins>;
   status = "okay";
  };
 };


 fragment@4 {
  target-path = "/soc/pwm@120d0000";
  __overlay__ {
   pinctrl-names = "default";
   pinctrl-0 = <&dt_pwm_ch6to7_pins>;
   status = "okay";
  };
 };
};
