# 0 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart5-pwm.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart5-pwm.dts"
/dts-v1/;
/plugin/;
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 4 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart5-pwm.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/starfive,jh7110-pinfunc.h" 1
# 5 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-uart5-pwm.dts" 2
/ {
 compatible = "starfive,jh7110";


 fragment@0 {
  target-path = "/soc/gpio@13040000";
  __overlay__ {
   dt_pwm_ch0to3_pins: dt-pwm-ch0to3-pins {
    pwm_ch0-pins {
     starfive,pins = <45>;
     starfive,pinmux = <(0x2a8U) 0xCU 0x7000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <24>;
     starfive,pin-gpio-doen = <9>;
    };

    pwm_ch1-pins {
     starfive,pins = <46>;
     starfive,pinmux = <(0x2a8U) 0xFU 0x38000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <25>;
     starfive,pin-gpio-doen = <10>;
    };

    pwm_ch2-pins {
     starfive,pins = <47>;
     starfive,pinmux = <(0x2a8U) 0x12U 0x1C0000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <26>;
     starfive,pin-gpio-doen = <11>;
    };

    pwm_ch3-pins {
     starfive,pins = <48>;
     starfive,pinmux = <(0x2a8U) 0x15U 0xE00000U 0>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <27>;
     starfive,pin-gpio-doen = <12>;
    };
   };
  };
 };


   fragment@1 {
  target-path = "/soc/gpio@17020000";
  __overlay__ {
   dt_pwm_ch4to5_pins: dt-pwm-ch4to5-pins {
    pwm-ch4-pins {
     starfive,pins = <1>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <3>;
     starfive,pin-gpio-doen = <2>;
    };

    pwm-ch5-pins {
     starfive,pins = <2>;
     starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
     starfive,pin-gpio-dout = <4>;
     starfive,pin-gpio-doen = <3>;
    };
   };
  };
 };


 fragment@2 {
  target-path = "/soc/serial@12020000";
  __overlay__ {
   status = "okay";
  };
 };


 fragment@3 {
  target-path = "/soc/pwm@120d0000";
  __overlay__ {
   pinctrl-names = "default";
   pinctrl-0 = <&dt_pwm_ch0to3_pins &dt_pwm_ch4to5_pins>;
   status = "okay";
  };
 };


   fragment@4 {
  target-path = "/soc/i2c@10030000";
  __overlay__ {
   status = "okay";
  };
 };


   fragment@5 {
  target-path = "/soc/i2c@10040000";
  __overlay__ {
   status = "okay";
  };
 };


   fragment@6 {
  target-path = "/soc/i2c@12030000";
  __overlay__ {
   status = "okay";
  };
 };
};
