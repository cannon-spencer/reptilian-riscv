# 0 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-rgb2hdmi.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-rgb2hdmi.dts"
/dts-v1/;
/plugin/;
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 4 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-rgb2hdmi.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/starfive,jh7110-pinfunc.h" 1
# 5 "arch/riscv/boot/dts/starfive/evb-overlay/jh7110-evb-overlay-rgb2hdmi.dts" 2
/ {
 compatible = "starfive,jh7110";


 fragment@0 {
  target-path = "/soc/tda988x_pin";
  __overlay__ {
   status = "okay";
  };
 };


 fragment@1 {
  target-path = "/soc/serial@10010000";
  __overlay__ {
   status = "okay";
  };
 };
};
