/dts-v1/;

/ {
    description = "K1 FSBL FIT";

    images {
        fsbl {
            data = /incbin/("FSBL.bin");
            type = "firmware";
            arch = "riscv";
            os = "u-boot";
            compression = "none";
            hash-1 {
                algo = "sha256";
            };
        };
    };

    configurations {
        default = "conf";
        conf {
            firmware = "fsbl";
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "rot_prv";
                sign-images = "firmware";
            };
        };
    };
};

